# ========================================================
# FLEX STOREFRONT — ENVIRONMENT CONFIGURATION
# ========================================================
# Copy this file to .env and provide your production credentials.
# Never commit real secret keys or production tokens to git.

# Application Environment
VITE_APP_NAME="FLEX"
VITE_APP_ENV="development"
VITE_APP_URL="https://flex-fit.shop"

# Storefront Currency & Logistics
VITE_DEFAULT_CURRENCY="INR"
VITE_FREE_SHIPPING_THRESHOLD=999
VITE_STANDARD_SHIPPING_FEE=99

# Payment Gateway Configuration (Test Mode / Sandbox)
# Set to 'test' or 'production'
VITE_PAYMENT_MODE="test"
VITE_RAZORPAY_KEY_ID="rzp_test_placeholder_key_id"
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_placeholder_stripe_key"

# Analytics & Performance Tracking (Optional)
VITE_GA_MEASUREMENT_ID=""

# Support Desk Endpoint
VITE_SUPPORT_EMAIL="support@flex-fit.shop"
VITE_DISPATCH_HUB_PINCODE="400050"

<section class="flex-hero-section" style="padding: 70px 0 60px 0; border-bottom: 1px solid var(--color-border); background: var(--color-bg);">
  <div class="flex-container">
    <div class="flex-hero-grid" style="display: grid; grid-template-columns: 1.1fr 1fr; gap: 50px; align-items: center;">
      
      <!-- Left Column Text -->
      <div>
        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 20px;">
          <span class="flex-tech-badge" style="border-color: rgba(203, 184, 154, 0.4); color: var(--color-accent);">
            EDITION 11_11 // EXPERIMENTAL LAB
          </span>
          <span class="flex-mono" style="font-size: 11px; color: var(--color-muted);">
            BATCH 004 &bull; LIVE
          </span>
        </div>

        <h1 class="flex-hero-title" style="font-size: 48px; line-height: 1.05; letter-spacing: -0.02em; margin-bottom: 16px;">
          {{ section.settings.heading | default: "ENGINEERED PHYSICAL MERCH &amp; ACTIVEWEAR" }}
        </h1>

        <p class="flex-mono" style="font-size: 13px; color: var(--color-accent); font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 14px;">
          {{ section.settings.subheading | default: "RESEARCH PREVIEW // PERFORMANCE DIVISION" }}
        </p>

        <p class="flex-hero-desc" style="font-size: 15px; color: #AAAAAA; line-height: 1.7; margin-bottom: 30px; max-width: 540px;">
          {{ section.settings.text | default: "Translating digital precision into tangible athletic textiles. High-density 240 GSM combed cottons, zoned warp-knit compression, and uninhibited kinetic range." }}
        </p>

        <div style="display: flex; gap: 14px; flex-wrap: wrap;">
          <a href="{{ section.settings.btn_1_link | default: routes.all_products_collection_url }}" class="flex-btn-primary flex-mono" style="padding: 14px 26px; border-radius: var(--radius-sm); font-size: 12px; letter-spacing: 0.08em; background: #FFFFFF; color: #000000; font-weight: 700;">
            [ {{ section.settings.btn_1_text | default: "EXPLORE ARCHIVE" }} &rarr; ]
          </a>

          <a href="{{ section.settings.btn_2_link | default: '/pages/about' }}" class="flex-btn-secondary flex-mono" style="padding: 14px 24px; border-radius: var(--radius-sm); font-size: 12px; letter-spacing: 0.08em; border: 1px solid var(--color-border); color: #FFF; background: var(--color-card);">
            [ {{ section.settings.btn_2_text | default: "LAB PROTOCOL" }} ]
          </a>
        </div>

        <!-- Technical Specification Bar -->
        <div style="margin-top: 40px; padding-top: 20px; border-top: 1px solid var(--color-border-subtle); display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px;">
          <div>
            <span class="flex-mono" style="font-size: 10px; color: var(--color-muted); display: block; text-transform: uppercase;">FABRIC DENSITY</span>
            <span class="flex-mono" style="font-size: 13px; font-weight: 700; color: #FFF;">240-420 GSM</span>
          </div>
          <div>
            <span class="flex-mono" style="font-size: 10px; color: var(--color-muted); display: block; text-transform: uppercase;">SEAM ARCHITECTURE</span>
            <span class="flex-mono" style="font-size: 13px; font-weight: 700; color: #FFF;">4-NEEDLE FLAT</span>
          </div>
          <div>
            <span class="flex-mono" style="font-size: 10px; color: var(--color-muted); display: block; text-transform: uppercase;">FULFILLMENT</span>
            <span class="flex-mono" style="font-size: 13px; font-weight: 700; color: #10B981;">24H DISPATCH</span>
          </div>
        </div>

      </div>

      <!-- Right Column Hero Lifestyle Media with Technical Studio Freight Annotations -->
      <div>
        <div style="border-radius: var(--radius-md); overflow: hidden; border: 1px solid var(--color-border); aspect-ratio: 4/5; background: var(--color-card); position: relative; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.5);">
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'eager', class: 'w-full h-full object-cover' }}
          {%- else -%}
            <img src="{{ 'muscle-tee-black.png' | asset_url }}" alt="FLEX Premium Gym Wear Outfit" width="800" height="1000" style="width: 100%; height: 100%; object-fit: cover; display: block;" loading="eager">
          {%- endif -%}

          <!-- Studio Freight Pointer Annotation Pins -->
          <div style="position: absolute; top: 22%; left: 16%; background: rgba(14, 14, 14, 0.85); backdrop-filter: blur(8px); border: 1px solid var(--color-border); padding: 5px 10px; border-radius: var(--radius-sm); display: flex; align-items: center; gap: 6px;">
            <span style="width: 6px; height: 6px; border-radius: 50%; background: var(--color-accent);"></span>
            <span class="flex-mono" style="font-size: 9px; color: #FFF; font-weight: 600;">RAW-CUT LAT FREEDOM</span>
          </div>

          <div style="position: absolute; bottom: 32%; right: 12%; background: rgba(14, 14, 14, 0.85); backdrop-filter: blur(8px); border: 1px solid var(--color-border); padding: 5px 10px; border-radius: var(--radius-sm); display: flex; align-items: center; gap: 6px;">
            <span style="width: 6px; height: 6px; border-radius: 50%; background: var(--color-accent);"></span>
            <span class="flex-mono" style="font-size: 9px; color: #FFF; font-weight: 600;">240 GSM COMBED VINTAGE COTTON</span>
          </div>

          <!-- Bottom Card Overlay -->
          <div style="position: absolute; bottom: 16px; left: 16px; right: 16px; background: rgba(10, 10, 10, 0.9); backdrop-filter: blur(12px); padding: 14px 18px; border-radius: var(--radius-sm); border: 1px solid rgba(255, 255, 255, 0.12); display: flex; justify-content: space-between; align-items: center;">
            <div>
              <span class="flex-mono" style="font-size: 9px; font-weight: 700; letter-spacing: 0.12em; color: var(--color-accent); text-transform: uppercase;">
                HARDWARE 01 &bull; SIGNATURE DROP
              </span>
              <p class="flex-mono" style="margin: 3px 0 0 0; font-size: 13px; font-weight: 700; color: #FFF;">
                OVERSIZED MUSCLE TEE &bull; WASHED BLACK
              </p>
            </div>
            <a href="/products/flex-oversized-muscle-tee" class="flex-btn-primary flex-mono" style="padding: 6px 12px; font-size: 11px; border-radius: var(--radius-sm);">
              VIEW [ &rarr; ]
            </a>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "FLEX Hero Banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "ENGINEERED PHYSICAL MERCH & ACTIVEWEAR"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "RESEARCH PREVIEW // PERFORMANCE DIVISION"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Translating digital precision into tangible athletic textiles. High-density 240 GSM combed cottons, zoned warp-knit compression, and uninhibited kinetic range."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Lifestyle Image"
    },
    {
      "type": "text",
      "id": "btn_1_text",
      "label": "Primary Button Text",
      "default": "EXPLORE ARCHIVE"
    },
    {
      "type": "url",
      "id": "btn_1_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "btn_2_text",
      "label": "Secondary Button Text",
      "default": "LAB PROTOCOL"
    },
    {
      "type": "url",
      "id": "btn_2_link",
      "label": "Secondary Button Link"
    }
  ],
  "presets": [
    {
      "name": "FLEX Hero Banner"
    }
  ]
}
{% endschema %}

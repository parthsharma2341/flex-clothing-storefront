<section class="flex-product-detail-section" style="padding: 40px 0 90px 0; border-bottom: 1px solid var(--color-border); background: var(--color-bg);">
  <div class="flex-container">

    {%- assign current_variant = product.selected_or_first_available_variant -%}
    {%- assign handle_str = product.handle | downcase -%}
    {%- assign title_str = product.title | downcase -%}
    {%- assign type_str = product.type | downcase -%}

    <!-- Technical Header Bar / Breadcrumbs (ElevenLabs / Studio Freight style) -->
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 30px; padding-bottom: 16px; border-bottom: 1px solid var(--color-border-subtle);">
      <div style="display: flex; align-items: center; gap: 10px;">
        <a href="{{ routes.all_products_collection_url }}" class="flex-mono" style="font-size: 11px; color: var(--color-muted); text-transform: uppercase; text-decoration: none;">
          &larr; [ BACK TO ARCHIVE ]
        </a>
        <span class="flex-tech-badge">
          SYS_REF: {{ product.id | default: "FLX-2026-01" }}
        </span>
        <span class="flex-tech-badge" style="border-color: rgba(203, 184, 154, 0.4); color: var(--color-accent);">
          EDITION 11_11
        </span>
      </div>

      <div class="flex-pulse-indicator">
        <span class="flex-pulse-dot"></span>
        <span>IN STOCK &bull; DISPATCHES IN 24H</span>
      </div>
    </div>

    <!-- Main Product Layout Grid -->
    <div class="flex-product-layout" style="display: grid; grid-template-columns: 1fr; gap: 50px; align-items: start;">
      
      <!-- LEFT COLUMN: Multi-Angle Technical Media Stage -->
      <div class="flex-product-media-col" style="position: sticky; top: 90px;">
        
        <!-- Determine Default Main Image and Fallbacks -->
        {%- assign main_img_url = '' -%}
        {%- if current_variant.featured_image != blank -%}
          {%- assign main_img_url = current_variant.featured_image | image_url: width: 1200 -%}
        {%- elsif product.featured_image != blank -%}
          {%- assign main_img_url = product.featured_image | image_url: width: 1200 -%}
        {%- else -%}
          {%- if handle_str contains 'compression' or title_str contains 'compression' or type_str contains 'compression' -%}
            {%- assign main_img_url = 'compression-tee-black.jpg' | asset_url -%}
            {%- assign angle_2 = 'compression-tee-blue.png' | asset_url -%}
            {%- assign angle_3 = 'compression-blue-poster.png' | asset_url -%}
          {%- elsif handle_str contains 'jogger' or title_str contains 'jogger' or handle_str contains 'stripe' -%}
            {%- assign main_img_url = 'stripe-joggers-grey.png' | asset_url -%}
            {%- assign angle_2 = 'Minimalist FLEX Stripe Sweatpants Catalog Shot (1).png' | asset_url -%}
            {%- assign angle_3 = 'Minimalist FLEX Stripe Sweatpants Catalog Shot.png' | asset_url -%}
          {%- elsif handle_str contains 'waffle' or handle_str contains 'henley' or title_str contains 'henley' -%}
            {%- assign main_img_url = 'waffle-henley.png' | asset_url -%}
            {%- assign angle_2 = 'FLEX Waffle Henley Lookbook.png' | asset_url -%}
            {%- assign angle_3 = 'FLEX Performance Apparel Feature Poster.png' | asset_url -%}
          {%- elsif handle_str contains 'wide-leg' or handle_str contains 'sweatpants' or title_str contains 'wide-leg' -%}
            {%- assign main_img_url = 'wide-leg-sweatpants.png' | asset_url -%}
            {%- assign angle_2 = 'athletic-sweatpants.png' | asset_url -%}
            {%- assign angle_3 = 'FLEX Logo Wide-Leg Sweatpants.png' | asset_url -%}
          {%- elsif handle_str contains 'hoodie' or title_str contains 'hoodie' -%}
            {%- assign main_img_url = 'athletic-sweatpants.png' | asset_url -%}
            {%- assign angle_2 = 'FLEX Performance Apparel Feature Poster.png' | asset_url -%}
            {%- assign angle_3 = 'wide-leg-sweatpants.png' | asset_url -%}
          {%- elsif handle_str contains 'stringer' or handle_str contains 'tank' or title_str contains 'tank' -%}
            {%- assign main_img_url = 'muscle-tee-features.png' | asset_url -%}
            {%- assign angle_2 = 'muscle-tee-black.png' | asset_url -%}
            {%- assign angle_3 = 'FLEX Washed Black Muscle Tee Collage.png' | asset_url -%}
          {%- else -%}
            {%- assign main_img_url = 'muscle-tee-black.png' | asset_url -%}
            {%- assign angle_2 = 'muscle-tee-features.png' | asset_url -%}
            {%- assign angle_3 = 'FLEX Washed Black Muscle Tee Collage.png' | asset_url -%}
          {%- endif -%}
        {%- endif -%}

        <!-- Main Image Container -->
        <div id="flex-main-media" style="border-radius: var(--radius-md); overflow: hidden; border: 1px solid var(--color-border); aspect-ratio: 1/1; background: var(--color-card); position: relative; box-shadow: 0 20px 40px rgba(0,0,0,0.4);">
          <img id="flex-featured-img" src="{{ main_img_url }}" alt="{{ product.title | escape }}" width="1200" height="1200" style="width: 100%; height: 100%; object-fit: cover; transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1), transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);" loading="eager">

          <!-- Corner Metadata Tag -->
          <div style="position: absolute; top: 16px; left: 16px; display: flex; gap: 8px;">
            <span class="flex-tech-badge" style="background: rgba(10, 10, 10, 0.85); backdrop-filter: blur(8px);">
              FIG. 01_PRIMARY
            </span>
            {%- if product.compare_at_price > product.price -%}
              <span class="flex-tech-badge" style="background: rgba(239, 68, 68, 0.9); color: #FFF; border: none;">
                SALE
              </span>
            {%- endif -%}
          </div>

          <div style="position: absolute; bottom: 16px; right: 16px;">
            <span class="flex-tech-badge" style="background: rgba(10, 10, 10, 0.85); backdrop-filter: blur(8px); font-size: 10px;">
              SCALE: 1:1 TRUE FORM
            </span>
          </div>
        </div>

        <!-- Studio Freight Dynamic Multi-Angle Switcher -->
        <div class="flex-view-switcher" id="flex-view-switcher">
          {%- if product.images.size > 1 -%}
            {%- for media_img in product.images -%}
              <button type="button" class="flex-view-btn {% if forloop.first %}active{% endif %}" onclick="switchMediaView(this, '{{ media_img | image_url: width: 1200 }}')">
                <span>[ 0{{ forloop.index }} ]</span>
                {%- if forloop.index == 1 -%}FRONT ELEVATION
                {%- elsif forloop.index == 2 -%}MACRO TEXTURE
                {%- elsif forloop.index == 3 -%}STUDIO DRAPE
                {%- else -%}ANGLE 0{{ forloop.index }}
                {%- endif -%}
              </button>
            {%- endfor -%}
          {%- else -%}
            <button type="button" class="flex-view-btn active" onclick="switchMediaView(this, '{{ main_img_url }}')">
              <span>[ 01 ]</span> FRONT ELEVATION
            </button>
            {%- if angle_2 != blank -%}
              <button type="button" class="flex-view-btn" onclick="switchMediaView(this, '{{ angle_2 }}')">
                <span>[ 02 ]</span> MACRO TEXTURE
              </button>
            {%- endif -%}
            {%- if angle_3 != blank -%}
              <button type="button" class="flex-view-btn" onclick="switchMediaView(this, '{{ angle_3 }}')">
                <span>[ 03 ]</span> STUDIO DRAPE
              </button>
            {%- endif -%}
          {%- endif -%}
        </div>
      </div>

      <!-- RIGHT COLUMN: Technical Specification & Purchase Module -->
      <div class="flex-product-info-col">
        
        <!-- Category & Series Tag -->
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
          <span class="flex-mono" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.15em; color: var(--color-accent); font-weight: 700;">
            [ {{ product.type | default: "EQUIPMENT // ATHLETIC TEXTILES" }} ]
          </span>
          <span class="flex-mono" style="font-size: 11px; color: var(--color-muted); letter-spacing: 0.1em;">
            BATCH #004 / 2026
          </span>
        </div>

        <!-- Product Title -->
        <h1 style="font-size: 34px; font-family: var(--font-heading); margin: 0 0 16px 0; text-transform: uppercase; letter-spacing: 0.01em; line-height: 1.15;">
          {{ product.title | default: "FLEX 01 // OVERSIZED MUSCLE TEE" }}
        </h1>

        <!-- Price & Batch Discount Badge -->
        <div style="display: flex; align-items: baseline; gap: 14px; margin-bottom: 18px; padding-bottom: 18px; border-bottom: 1px solid var(--color-border-subtle);">
          <span id="flex-product-price-display" class="flex-mono" style="font-size: 28px; font-weight: 700; color: #FFFFFF;">
            {{ current_variant.price | default: product.price | money | default: "₹1,199" }}
          </span>
          {%- if product.compare_at_price > product.price -%}
            <span id="flex-compare-price-display" class="flex-mono" style="font-size: 16px; text-decoration: line-through; color: var(--color-muted);">
              {{ current_variant.compare_at_price | default: product.compare_at_price | money | default: "₹1,799" }}
            </span>
            <span class="flex-tech-badge" style="border-color: rgba(239, 68, 68, 0.4); color: #EF4444; background: rgba(239, 68, 68, 0.06);">
              SALE DROP
            </span>
          {%- endif -%}
        </div>

        <!-- Real-Time Stock Status Notification -->
        <div style="background: rgba(16, 185, 129, 0.06); border: 1px solid rgba(16, 185, 129, 0.25); border-radius: var(--radius-sm); padding: 10px 14px; margin-bottom: 24px; display: flex; align-items: center; justify-content: space-between;">
          <div style="display: flex; align-items: center; gap: 8px;">
            <span class="flex-pulse-dot"></span>
            <span class="flex-mono" style="font-size: 11px; color: #10B981; font-weight: 600;">
              AVAILABLE FOR IMMEDIATE DISPATCH
            </span>
          </div>
          <span class="flex-mono" style="font-size: 11px; color: var(--color-muted);">
            NEXT RUN: 14:00 IST
          </span>
        </div>

        <!-- ElevenLabs Signature: Interactive Fabric Soundwave / Kinetic Tension Visualizer -->
        <div class="flex-audio-preview" onclick="toggleFabricWave(this)" title="Click to listen to fabric motion resonance">
          <div style="display: flex; align-items: center; gap: 12px;">
            <button type="button" style="width: 32px; height: 32px; border-radius: 50%; background: #FFF; border: none; display: flex; align-items: center; justify-content: center; cursor: pointer; color: #000; font-size: 12px;">
              &#9658;
            </button>
            <div>
              <p class="flex-mono" style="font-size: 11px; font-weight: 700; margin: 0; color: #FFF; text-transform: uppercase;">
                FABRIC RESONANCE &amp; TENSION PREVIEW
              </p>
              <p class="flex-mono" style="font-size: 10px; color: var(--color-muted); margin: 2px 0 0 0;">
                ACOUSTIC MOTION FIELD RECORDING &bull; 0:14
              </p>
            </div>
          </div>

          <div class="flex-wave-bars">
            <span class="flex-wave-bar"></span>
            <span class="flex-wave-bar"></span>
            <span class="flex-wave-bar"></span>
            <span class="flex-wave-bar"></span>
            <span class="flex-wave-bar"></span>
            <span class="flex-wave-bar"></span>
            <span class="flex-wave-bar"></span>
            <span class="flex-wave-bar"></span>
          </div>
        </div>

        <!-- Order / Variant Form -->
        <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" id="flex-add-to-cart-form">
          <input type="hidden" name="id" id="flex-variant-id-input" value="{{ current_variant.id | default: '1' }}">

          <!-- DETECT COLOR OPTIONS -->
          {%- assign color_option = nil -%}
          {%- assign size_option = nil -%}
          {%- for opt in product.options_with_values -%}
            {%- assign opt_lower = opt.name | downcase -%}
            {%- if opt_lower contains 'color' or opt_lower contains 'colour' or opt_lower contains 'colorway' or opt_lower contains 'finish' -%}
              {%- assign color_option = opt -%}
            {%- elsif opt_lower contains 'size' -%}
              {%- assign size_option = opt -%}
            {%- endif -%}
          {%- endfor -%}

          <!-- DYNAMIC COLORWAY SELECTION WITH IMAGE SWAPPING -->
          <div style="margin-bottom: 22px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
              <span class="flex-mono" style="font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--color-muted); letter-spacing: 0.08em;">
                COLORWAY // FINISH:
              </span>
              <span id="active-color-name" class="flex-mono" style="font-size: 11px; color: #FFF; font-weight: 700; text-transform: uppercase;">
                {%- if color_option != nil -%}
                  {{ color_option.selected_value | default: color_option.values.first }}
                {%- elsif handle_str contains 'compression' -%}
                  ONYX BLACK
                {%- elsif handle_str contains 'jogger' -%}
                  HEATHER GREY
                {%- elsif handle_str contains 'waffle' -%}
                  CHALK OFF-WHITE
                {%- elsif handle_str contains 'wide-leg' -%}
                  VINTAGE CHARCOAL
                {%- else -%}
                  WASHED BLACK
                {%- endif -%}
              </span>
            </div>

            <div style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap;" id="flex-colorways-list">
              {%- if color_option != nil -%}
                {%- for val in color_option.values -%}
                  {%- assign val_lower = val | downcase -%}
                  {%- assign swatch_hex = '#1B1B1B' -%}
                  {%- if val_lower contains 'black' or val_lower contains 'onyx' or val_lower contains 'pitch' -%}
                    {%- assign swatch_hex = '#121212' -%}
                  {%- elsif val_lower contains 'blue' or val_lower contains 'ocean' or val_lower contains 'navy' -%}
                    {%- assign swatch_hex = '#1E3A8A' -%}
                  {%- elsif val_lower contains 'grey' or val_lower contains 'gray' or val_lower contains 'slate' or val_lower contains 'heather' -%}
                    {%- assign swatch_hex = '#4B5563' -%}
                  {%- elsif val_lower contains 'white' or val_lower contains 'chalk' or val_lower contains 'bone' -%}
                    {%- assign swatch_hex = '#D8D2C2' -%}
                  {%- elsif val_lower contains 'charcoal' -%}
                    {%- assign swatch_hex = '#262626' -%}
                  {%- endif -%}

                  <!-- Find Variant Image for this Color -->
                  {%- assign variant_img = '' -%}
                  {%- assign variant_target_id = '' -%}
                  {%- assign variant_target_price = '' -%}
                  {%- for v in product.variants -%}
                    {%- if v.options contains val -%}
                      {%- if v.featured_image != blank and variant_img == '' -%}
                        {%- assign variant_img = v.featured_image | image_url: width: 1200 -%}
                        {%- assign variant_target_id = v.id -%}
                        {%- assign variant_target_price = v.price | money -%}
                      {%- endif -%}
                    {%- endif -%}
                  {%- endfor -%}

                  <!-- Fallback Smart Image Match if merchant has not uploaded variant images -->
                  {%- if variant_img == '' -%}
                    {%- if val_lower contains 'blue' -%}
                      {%- assign variant_img = 'compression-tee-blue.png' | asset_url -%}
                    {%- elsif val_lower contains 'black' or val_lower contains 'onyx' -%}
                      {%- if handle_str contains 'compression' -%}
                        {%- assign variant_img = 'compression-tee-black.jpg' | asset_url -%}
                      {%- else -%}
                        {%- assign variant_img = 'muscle-tee-black.png' | asset_url -%}
                      {%- endif -%}
                    {%- elsif val_lower contains 'slate' -%}
                      {%- assign variant_img = 'muscle-tee-features.png' | asset_url -%}
                    {%- elsif val_lower contains 'grey' or val_lower contains 'heather' -%}
                      {%- assign variant_img = 'stripe-joggers-grey.png' | asset_url -%}
                    {%- elsif val_lower contains 'white' or val_lower contains 'chalk' -%}
                      {%- assign variant_img = 'waffle-henley.png' | asset_url -%}
                    {%- elsif val_lower contains 'charcoal' -%}
                      {%- assign variant_img = 'wide-leg-sweatpants.png' | asset_url -%}
                    {%- else -%}
                      {%- assign variant_img = main_img_url -%}
                    {%- endif -%}
                  {%- endif -%}

                  <div 
                    class="flex-color-swatch {% if forloop.first %}active{% endif %}"
                    onclick="selectTechnicalColor(this, '{{ val | escape }}', '{{ variant_img }}', '{{ variant_target_id }}', '{{ variant_target_price }}')"
                    style="width: 38px; height: 38px; border-radius: var(--radius-sm); background: {{ swatch_hex }}; border: {% if forloop.first %}2px solid #FFF{% else %}1px solid var(--color-border){% endif %}; cursor: pointer; position: relative; transition: all 0.2s ease; {% if forloop.first %}box-shadow: 0 0 0 2px rgba(255,255,255,0.4);{% endif %}"
                    title="{{ val | escape }}"
                  >
                  </div>
                {%- endfor -%}
              {%- else -%}
                <!-- Curated fallback colorways if product has no color option defined -->
                {%- if handle_str contains 'compression' or title_str contains 'compression' -%}
                  <div class="flex-color-swatch active" onclick="selectTechnicalColor(this, 'ONYX BLACK', '{{ 'compression-tee-black.jpg' | asset_url }}', '{{ current_variant.id }}', '')" style="width: 38px; height: 38px; border-radius: var(--radius-sm); background: #0B0B0B; border: 2px solid #FFF; cursor: pointer; box-shadow: 0 0 0 2px rgba(255,255,255,0.4);" title="Onyx Black"></div>
                  <div class="flex-color-swatch" onclick="selectTechnicalColor(this, 'OCEAN BLUE', '{{ 'compression-tee-blue.png' | asset_url }}', '{{ current_variant.id }}', '')" style="width: 38px; height: 38px; border-radius: var(--radius-sm); background: #1B3B6F; border: 1px solid var(--color-border); cursor: pointer;" title="Ocean Blue (Drop 02)"></div>
                {%- elsif handle_str contains 'jogger' or title_str contains 'jogger' -%}
                  <div class="flex-color-swatch active" onclick="selectTechnicalColor(this, 'HEATHER GREY', '{{ 'stripe-joggers-grey.png' | asset_url }}', '{{ current_variant.id }}', '')" style="width: 38px; height: 38px; border-radius: var(--radius-sm); background: #4B5563; border: 2px solid #FFF; cursor: pointer; box-shadow: 0 0 0 2px rgba(255,255,255,0.4);" title="Heather Grey"></div>
                  <div class="flex-color-swatch" onclick="selectTechnicalColor(this, 'PITCH BLACK', '{{ 'wide-leg-sweatpants.png' | asset_url }}', '{{ current_variant.id }}', '')" style="width: 38px; height: 38px; border-radius: var(--radius-sm); background: #111111; border: 1px solid var(--color-border); cursor: pointer;" title="Pitch Black"></div>
                {%- elsif handle_str contains 'waffle' or title_str contains 'henley' -%}
                  <div class="flex-color-swatch active" onclick="selectTechnicalColor(this, 'CHALK OFF-WHITE', '{{ 'waffle-henley.png' | asset_url }}', '{{ current_variant.id }}', '')" style="width: 38px; height: 38px; border-radius: var(--radius-sm); background: #D8D2C2; border: 2px solid #FFF; cursor: pointer; box-shadow: 0 0 0 2px rgba(255,255,255,0.4);" title="Chalk Off-White"></div>
                  <div class="flex-color-swatch" onclick="selectTechnicalColor(this, 'SLATE DUST', '{{ 'FLEX Waffle Henley Lookbook.png' | asset_url }}', '{{ current_variant.id }}', '')" style="width: 38px; height: 38px; border-radius: var(--radius-sm); background: #2A2A2A; border: 1px solid var(--color-border); cursor: pointer;" title="Slate Dust"></div>
                {%- elsif handle_str contains 'wide-leg' or title_str contains 'sweatpants' -%}
                  <div class="flex-color-swatch active" onclick="selectTechnicalColor(this, 'VINTAGE CHARCOAL', '{{ 'wide-leg-sweatpants.png' | asset_url }}', '{{ current_variant.id }}', '')" style="width: 38px; height: 38px; border-radius: var(--radius-sm); background: #262626; border: 2px solid #FFF; cursor: pointer; box-shadow: 0 0 0 2px rgba(255,255,255,0.4);" title="Vintage Charcoal"></div>
                  <div class="flex-color-swatch" onclick="selectTechnicalColor(this, 'RAW BONE', '{{ 'athletic-sweatpants.png' | asset_url }}', '{{ current_variant.id }}', '')" style="width: 38px; height: 38px; border-radius: var(--radius-sm); background: #E2DEC9; border: 1px solid var(--color-border); cursor: pointer;" title="Raw Bone"></div>
                {%- else -%}
                  <div class="flex-color-swatch active" onclick="selectTechnicalColor(this, 'WASHED BLACK', '{{ 'muscle-tee-black.png' | asset_url }}', '{{ current_variant.id }}', '')" style="width: 38px; height: 38px; border-radius: var(--radius-sm); background: #1C1C1E; border: 2px solid #FFF; cursor: pointer; box-shadow: 0 0 0 2px rgba(255,255,255,0.4);" title="Washed Black"></div>
                  <div class="flex-color-swatch" onclick="selectTechnicalColor(this, 'VINTAGE SLATE', '{{ 'muscle-tee-features.png' | asset_url }}', '{{ current_variant.id }}', '')" style="width: 38px; height: 38px; border-radius: var(--radius-sm); background: #2C2D30; border: 1px solid var(--color-border); cursor: pointer;" title="Vintage Slate"></div>
                {%- endif -%}
              {%- endif -%}
            </div>
          </div>

          <!-- Studio Freight Size Selector Grid -->
          <div style="margin-bottom: 24px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
              <span class="flex-mono" style="font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--color-muted); letter-spacing: 0.08em;">
                SPECIFICATION // SELECT SIZE
              </span>
              <a href="#size-guide" onclick="alert('CHEST SPECIFICATIONS:\nS: 38-40 inch chest\nM: 40-42 inch chest\nL: 42-44 inch chest\nXL: 44-46 inch chest\nXXL: 46-48 inch chest\n\nModel is 6\'1, 88kg wearing Size L (Athletic Loose Fit).'); return false;" class="flex-mono" style="font-size: 11px; color: var(--color-accent); text-decoration: underline;">
                [ SIZE ADVISOR &rarr; ]
              </a>
            </div>

            <div class="flex-size-grid">
              {%- if size_option != nil -%}
                {%- for s_val in size_option.values -%}
                  {%- assign s_upper = s_val | upcase -%}
                  {%- assign chest_spec = '40" CHEST' -%}
                  {%- if s_upper == 'S' -%}{%- assign chest_spec = '38" CHEST' -%}
                  {%- elsif s_upper == 'M' -%}{%- assign chest_spec = '40" CHEST' -%}
                  {%- elsif s_upper == 'L' -%}{%- assign chest_spec = '42" CHEST' -%}
                  {%- elsif s_upper == 'XL' -%}{%- assign chest_spec = '44" CHEST' -%}
                  {%- elsif s_upper == 'XXL' or s_upper == '2XL' -%}{%- assign chest_spec = '46" CHEST' -%}
                  {%- endif -%}

                  <!-- Find Variant ID for size -->
                  {%- assign size_variant_id = '' -%}
                  {%- for v in product.variants -%}
                    {%- if v.options contains s_val -%}
                      {%- assign size_variant_id = v.id -%}
                    {%- endif -%}
                  {%- endfor -%}

                  <div class="flex-size-pill {% if forloop.index == 2 or forloop.first and size_option.values.size < 2 %}active{% endif %}" onclick="selectTechnicalSize(this, '{{ s_val }}', '{{ size_variant_id }}')">
                    <span class="size-title">{{ s_val }}</span>
                    <span class="size-sub">{{ chest_spec }}</span>
                  </div>
                {%- endfor -%}
              {%- else -%}
                <div class="flex-size-pill" onclick="selectTechnicalSize(this, 'S', '{{ current_variant.id }}')">
                  <span class="size-title">S</span>
                  <span class="size-sub">38" CHEST</span>
                </div>
                <div class="flex-size-pill active" onclick="selectTechnicalSize(this, 'M', '{{ current_variant.id }}')">
                  <span class="size-title">M</span>
                  <span class="size-sub">40" CHEST</span>
                </div>

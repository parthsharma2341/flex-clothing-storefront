<!-- Studio Freight Color & Media Micro-Interactions Script -->
<script>
  function switchMediaView(btn, imageUrl) {
    const mainImg = document.getElementById('flex-featured-img');
    if (mainImg && imageUrl) {
      mainImg.style.opacity = '0.2';
      mainImg.style.transform = 'scale(0.98)';
      setTimeout(() => {
        mainImg.src = imageUrl;
        mainImg.style.opacity = '1';
        mainImg.style.transform = 'scale(1)';
      }, 150);
    }
    document.querySelectorAll('.flex-view-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
  }

  function selectTechnicalColor(swatchEl, colorName, imageUrl, variantId, priceFormatted) {
    // 1. Update swatch styling
    document.querySelectorAll('.flex-color-swatch').forEach(s => {
      s.classList.remove('active');
      s.style.borderColor = 'var(--color-border)';
      s.style.boxShadow = 'none';
    });
    swatchEl.classList.add('active');
    swatchEl.style.borderColor = '#FFFFFF';
    swatchEl.style.boxShadow = '0 0 0 2px rgba(255, 255, 255, 0.4)';

    // 2. Update active color text
    const label = document.getElementById('active-color-name');
    if (label && colorName) {
      label.textContent = colorName.toUpperCase();
    }

    // 3. Smoothly switch main featured image
    const mainImg = document.getElementById('flex-featured-img');
    if (mainImg && imageUrl) {
      mainImg.style.opacity = '0.2';
      mainImg.style.transform = 'scale(0.97)';
      setTimeout(() => {
        mainImg.src = imageUrl;
        mainImg.style.opacity = '1';
        mainImg.style.transform = 'scale(1)';
      }, 160);
    }

    // 4. Update the first view switcher button to point to this new color image
    const firstViewBtn = document.querySelector('.flex-view-switcher .flex-view-btn:first-child');
    if (firstViewBtn && imageUrl) {
      firstViewBtn.setAttribute('onclick', `switchMediaView(this, '${imageUrl}')`);
      document.querySelectorAll('.flex-view-btn').forEach(b => b.classList.remove('active'));
      firstViewBtn.classList.add('active');
    }

    // 5. Update hidden variant input and URL
    if (variantId && variantId.trim() !== '') {
      const varInput = document.getElementById('flex-variant-id-input');
      if (varInput) varInput.value = variantId;

      if (window.history && window.history.replaceState) {
        const url = new URL(window.location);
        url.searchParams.set('variant', variantId);
        window.history.replaceState({}, '', url);
      }
    }

    // 6. Update price if variant has specific pricing
    if (priceFormatted && priceFormatted.trim() !== '') {
      const priceDisplay = document.getElementById('flex-product-price-display');
      if (priceDisplay) priceDisplay.textContent = priceFormatted;
      const ctaPriceDisplay = document.getElementById('flex-cta-price-display');
      if (ctaPriceDisplay) ctaPriceDisplay.textContent = priceFormatted + ' →';
    }
  }

  function selectTechnicalSize(pill, size, variantId) {
    document.querySelectorAll('.flex-size-pill').forEach(p => p.classList.remove('active'));
    pill.classList.add('active');
    const input = document.getElementById('selected-size-input');
    if (input) input.value = size;

    if (variantId && variantId.trim() !== '') {
      const varInput = document.getElementById('flex-variant-id-input');
      if (varInput) varInput.value = variantId;
    }
  }

  function toggleFabricWave(element) {
    const bars = element.querySelectorAll('.flex-wave-bar');
    bars.forEach(b => {
      b.style.animationDuration = (Math.random() * 0.6 + 0.3) + 's';
    });
  }
</script>

<style>

<section style="padding: 70px 0; border-bottom: 1px solid var(--color-border); background: var(--color-bg);">
  <div class="flex-container">
    
    <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 30px; padding-bottom: 16px; border-bottom: 1px solid var(--color-border-subtle);">
      <div>
        <span class="flex-mono" style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.15em; color: var(--color-accent);">
          [ {{ section.settings.subheading | default: "CURRENT DEPLOYMENT &bull; BATCH 004" }} ]
        </span>
        <h2 style="font-size: 32px; margin-top: 4px; letter-spacing: 0.01em;">
          {{ section.settings.heading | default: "FEATURED LAB EQUIPMENT" }}
        </h2>
      </div>
      <a href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}" class="flex-mono" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-muted);">
        VIEW COMPLETE DROP [ &rarr; ]
      </a>
    </div>

    <div class="flex-product-grid">
      {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
        <div class="flex-product-card">
          <div class="flex-product-image">
            <a href="{{ product.url }}">
              {%- if product.featured_image != blank -%}
                {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy' }}
              {%- else -%}
                <div style="width: 100%; height: 100%; background: #222;"></div>
              {%- endif -%}
            </a>
            {%- if product.compare_at_price > product.price -%}
              <span class="flex-product-badge">SALE</span>
            {%- endif -%}
          </div>

          <div class="flex-product-info">
            <div>
              <span class="flex-mono" style="font-size: 10px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-accent); font-weight: 700;">
                [ {{ product.type | default: "PERFORMANCE WEAR" }} ]
              </span>
              <a href="{{ product.url }}">
                <h3 class="flex-product-title">{{ product.title }}</h3>
              </a>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 14px; padding-top: 10px; border-top: 1px solid var(--color-border);">
              <div>
                <span class="flex-mono flex-product-price">{{ product.price | money }}</span>
                {%- if product.compare_at_price > product.price -%}
                  <span class="flex-mono flex-product-price-compare">{{ product.compare_at_price | money }}</span>
                {%- endif -%}
              </div>
              <a href="{{ product.url }}" class="flex-btn-primary flex-mono" style="padding: 6px 12px; font-size: 10px; border-radius: var(--radius-sm);">
                DETAILS [ &rarr; ]
              </a>
            </div>
          </div>
        </div>
      {%- else -%}
        <!-- Outfit 1: Muscle Tee -->
        <div class="flex-product-card">
          <div class="flex-product-image">
            <a href="/products/flex-oversized-muscle-tee">
              <img src="{{ 'muscle-tee-black.png' | asset_url }}" alt="FLEX Oversized Muscle Tee" width="600" height="750" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy">
            </a>
            <span class="flex-product-badge">BESTSELLER &bull; DROP 01</span>
          </div>
          <div class="flex-product-info">
            <div>
              <span class="flex-mono" style="font-size: 10px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-accent); font-weight: 700;">
                [ 240 GSM COTTON &bull; RAW-EDGE ]
              </span>
              <a href="/products/flex-oversized-muscle-tee">
                <h3 class="flex-product-title">FLEX 01 // OVERSIZED MUSCLE TEE</h3>
              </a>
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 14px; padding-top: 10px; border-top: 1px solid var(--color-border);">
              <div>
                <span class="flex-mono flex-product-price">₹1,199</span>
                <span class="flex-mono flex-product-price-compare">₹1,799</span>
              </div>
              <a href="/products/flex-oversized-muscle-tee" class="flex-btn-primary flex-mono" style="padding: 6px 12px; font-size: 10px; border-radius: var(--radius-sm);">
                DETAILS [ &rarr; ]
              </a>
            </div>
          </div>
        </div>

        <!-- Outfit 2: Compression Tee -->
        <div class="flex-product-card">
          <div class="flex-product-image">
            <a href="/products/flex-pro-seamless-compression-tee">
              <img src="{{ 'compression-tee-black.jpg' | asset_url }}" alt="FLEX Pro Seamless Compression Tee" width="600" height="750" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy">
            </a>
            <span class="flex-product-badge" style="background: #1E40AF;">ZONED COMPRESSION</span>
          </div>
          <div class="flex-product-info">
            <div>
              <span class="flex-mono" style="font-size: 10px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-accent); font-weight: 700;">
                [ 4-WAY ELASTANE WARP KNIT ]
              </span>
              <a href="/products/flex-pro-seamless-compression-tee">
                <h3 class="flex-product-title">FLEX 02 // SEAMLESS COMPRESSION</h3>
              </a>
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 14px; padding-top: 10px; border-top: 1px solid var(--color-border);">
              <div>
                <span class="flex-mono flex-product-price">₹1,299</span>
                <span class="flex-mono flex-product-price-compare">₹1,899</span>
              </div>
              <a href="/products/flex-pro-seamless-compression-tee" class="flex-btn-primary flex-mono" style="padding: 6px 12px; font-size: 10px; border-radius: var(--radius-sm);">
                DETAILS [ &rarr; ]
              </a>
            </div>
          </div>
        </div>

        <!-- Outfit 3: Stripe Joggers -->
        <div class="flex-product-card">
          <div class="flex-product-image">
            <a href="/products/flex-double-stripe-training-joggers">
              <img src="{{ 'stripe-joggers-grey.png' | asset_url }}" alt="FLEX Double Stripe Training Joggers" width="600" height="750" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy">
            </a>
            <span class="flex-product-badge">HEAVYWEIGHT TERRY</span>
          </div>
          <div class="flex-product-info">
            <div>
              <span class="flex-mono" style="font-size: 10px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-accent); font-weight: 700;">
                [ 360 GSM LOOPBACK &bull; YKK ZIPS ]
              </span>
              <a href="/products/flex-double-stripe-training-joggers">
                <h3 class="flex-product-title">FLEX 03 // DOUBLE STRIPE JOGGERS</h3>
              </a>
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 14px; padding-top: 10px; border-top: 1px solid var(--color-border);">
              <div>
                <span class="flex-mono flex-product-price">₹1,699</span>
                <span class="flex-mono flex-product-price-compare">₹2,499</span>
              </div>
              <a href="/products/flex-double-stripe-training-joggers" class="flex-btn-primary flex-mono" style="padding: 6px 12px; font-size: 10px; border-radius: var(--radius-sm);">
                DETAILS [ &rarr; ]
              </a>
            </div>
          </div>
        </div>

        <!-- Outfit 4: Waffle Henley -->
        <div class="flex-product-card">
          <div class="flex-product-image">
            <a href="/products/flex-waffle-henley-long-sleeve">
              <img src="{{ 'waffle-henley.png' | asset_url }}" alt="FLEX Waffle Henley Long Sleeve" width="600" height="750" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy">
            </a>
            <span class="flex-product-badge">THERMAL KNIT</span>
          </div>
          <div class="flex-product-info">
            <div>
              <span class="flex-mono" style="font-size: 10px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-accent); font-weight: 700;">
                [ HONEYCOMB WAFFLE &bull; CHALK ]
              </span>
              <a href="/products/flex-waffle-henley-long-sleeve">
                <h3 class="flex-product-title">FLEX 04 // WAFFLE HENLEY LONG SLEEVE</h3>
              </a>
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 14px; padding-top: 10px; border-top: 1px solid var(--color-border);">
              <div>
                <span class="flex-mono flex-product-price">₹1,499</span>
                <span class="flex-mono flex-product-price-compare">₹2,199</span>
              </div>
              <a href="/products/flex-waffle-henley-long-sleeve" class="flex-btn-primary flex-mono" style="padding: 6px 12px; font-size: 10px; border-radius: var(--radius-sm);">
                DETAILS [ &rarr; ]
              </a>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FEATURED LAB EQUIPMENT"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "CURRENT DEPLOYMENT • BATCH 004"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 2,
      "default": 4,
      "label": "Number of products to show"
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}
